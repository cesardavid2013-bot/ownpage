# Lumi app configuration. EVERY EXPO_PUBLIC_* VALUE IS BUNDLED INTO THE APP AND VISIBLE TO USERS.
# Only public identifiers belong here: never a secret key.

# API base URL. "same-origin" when the web build is served by the API itself (Docker / Render).
EXPO_PUBLIC_API_URL=http://localhost:4000

# RevenueCat *public* SDK keys (appl_... / goog_...). These are designed to ship in apps.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
