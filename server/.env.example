# Copy to .env and fill in.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dating_dev
# Use a long random string in production (openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string
# Comma separated list of allowed web origins (the website / Expo web)
CORS_ORIGINS=http://localhost:8081
# Public base URL of this API, used to build photo URLs
PUBLIC_URL=http://localhost:4000
# Where the web app lives (Stripe redirects back here)
WEB_APP_URL=http://localhost:8081

# --- Stripe (web payments) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_GOLD_MONTHLY=
STRIPE_PRICE_PLATINUM_MONTHLY=
STRIPE_PRICE_BOOST_PACK=
STRIPE_PRICE_SUPERLIKE_PACK=

# --- RevenueCat (iOS / Android in-app purchases) ---
REVENUECAT_WEBHOOK_AUTH=
