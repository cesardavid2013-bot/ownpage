# Lumi API configuration. Copy to .env for local development.
# EVERYTHING IN THIS FILE IS SERVER-ONLY. Never put these values in the app or website.

# ---- Required in production ----------------------------------------------------------------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dating_dev
# 32+ random characters: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Moderators sign in at /admin with this (32+ random characters). Empty disables the admin API.
ADMIN_TOKEN=

# ---- URLs ---------------------------------------------------------------------------------
# Public base URL of this API (photo links are built from it). On Render this defaults to RENDER_EXTERNAL_URL.
PUBLIC_URL=http://localhost:4000
# Where Stripe sends people back after checkout. Defaults to PUBLIC_URL when WEB_DIR is set.
WEB_APP_URL=http://localhost:8081
# Serve the exported web app (app/dist) from this server. Set by the Docker image.
WEB_DIR=
# Extra origins allowed to call the API from a browser (comma separated). Production default: none.
CORS_ORIGINS=http://localhost:8081
# Where uploaded photos live. Use a persistent disk in production (the Docker image uses /data/uploads).
UPLOAD_DIR=uploads

# ---- Web payments (Stripe) — server-only secret keys -------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_GOLD_MONTHLY=
STRIPE_PRICE_GOLD_YEARLY=
STRIPE_PRICE_PLATINUM_MONTHLY=
STRIPE_PRICE_PLATINUM_YEARLY=
STRIPE_PRICE_BOOST_PACK=
STRIPE_PRICE_SUPERLIKE_PACK=

# ---- In-app purchases (RevenueCat webhook) ------------------------------------------------
REVENUECAT_WEBHOOK_AUTH=
